          {
            "numero": 15,
            "titolo": "Il mondo senza apprendisti",
            "href": "/saggi/saggio-15-il-mondo-senza-apprendisti.html",
            "rapporto": "diretto",
            "motivazione": "Nel §7 Gentili richiama il costruttore di Aristotele. Una prima bozza, la correzione di chi ha esperienza e il tentativo successivo mostrano come si formi il giudizio di un apprendista. Il saggio segue ciò che accade a questa pratica quando una parte del lavoro passa all’intelligenza artificiale.",
            "riscontro": "Saggio 15, §7. Il saggio cita Aristotele e rinvia già alla guida."
          },
          {
            "numero": 18,
            "titolo": "Il futuro che sapevamo",
            "href": "/saggi/saggio-18-il-futuro-che-sapevamo.html#il-futuro-non-vota",
            "rapporto": "interpretativo",
            "motivazione": "Nella guida Aristotele invita a giudicare la città dal bene verso cui tende. In «Il futuro non vota» Gentili chiede chi possa rappresentare le persone su cui ricadranno domani i costi delle decisioni di oggi. Accostare i due passi permette di chiedersi chi venga incluso nel bene comune.",
            "riscontro": "Saggio 18, Il futuro non vota. Accostamento editoriale alla domanda sul fine della città."
          }
        ],
        "triade": {
          "numero": 3,
          "titolo": "Tempo, forma, disincanto",
          "href": "/cerchi/triadi/#triade-3",
          "motivazione": "Seneca interroga l’uso del tempo, Aristotele la forma che può assumere una vita, Weber la razionalizzazione dei mezzi. La triade raccoglie le tre prospettive intorno alla domanda «Quale forma dare al tempo che ci è concesso?»."
        }
      },
